# Architecture rules for the overwatch package (hexagonal layout).
# Run from backend/: uv run lint-imports (set PYTHONIOENCODING=utf-8 on Windows, see lesson L1).
# Each contract is a rule the build enforces. Add new adapter packages to the
# "Adapters are independent" contract as they are created. Wildcards cover today's
# children; a package that is not covered by a wildcard is not checked.

[importlinter]
root_packages =
    overwatch
include_external_packages = True

[importlinter:contract:layers]
name = Layers
type = layers
containers = overwatch
layers =
    bootstrap
    adapters
    application
    domain

[importlinter:contract:domain-pure]
name = Domain stays pure
type = forbidden
source_modules =
    overwatch.domain
forbidden_modules =
    fastapi
    neo4j
    redis
    azure
    httpx
    twilio
    pydantic_settings
    opentelemetry
    overwatch.application
    overwatch.adapters
    overwatch.bootstrap

[importlinter:contract:application-pure]
name = Application stays pure
type = forbidden
source_modules =
    overwatch.application
forbidden_modules =
    fastapi
    neo4j
    redis
    azure
    httpx
    twilio
    pydantic_settings
    opentelemetry
    overwatch.adapters
    overwatch.bootstrap

# TEN-001, DEC-142: the tenancy kernel is imported by the adapters and must pull nothing in with it.
[importlinter:contract:tenancy-kernel]
name = The tenancy kernel is standard library only
type = forbidden
source_modules =
    overwatch.application.tenancy
forbidden_modules =
    overwatch.domain
    overwatch.adapters
    overwatch.bootstrap
    neo4j
    redis
    azure
    fastapi
    httpx
    twilio
    pydantic
    pydantic_settings

[importlinter:contract:adapters-independent]
name = Adapters are independent
type = independence
modules =
    overwatch.adapters.inbound.*
    overwatch.adapters.outbound.*
    overwatch.adapters.testing
# DEC-055: the audit adapter runs its queries through the G01 driver and query registry.
# DEC-084: the outbox runs its queries the same way, and the Neo4j unit of work is the one place
# that wires the audit log and the outbox into the transaction it hands out.
# TEN-004 (DEC-150): a statement carries a scenario, and the outbox builds its own from the
# scenario types of the graph store. TEN-017 gives the audit statements the same scenario types.
# I05 (DEC-196): the scheduled-work consumer reuses the I04 consumer core, the I08 tenant binding
# and the ActiveTenants protocol of the workers package, as the reply processor does.
# I07 (DEC-149): the FHIR app mounts the Twilio webhook router, and the webhook reuses I06's
# mapping of a Twilio status, so the two statuses cannot disagree.
ignore_imports =
    overwatch.adapters.outbound.audit_neo4j.audit_log -> overwatch.adapters.outbound.graph_store.driver
    overwatch.adapters.outbound.audit_neo4j.audit_log -> overwatch.adapters.outbound.graph_store.queries
    overwatch.adapters.outbound.audit_neo4j.outbox -> overwatch.adapters.outbound.graph_store.driver
    overwatch.adapters.outbound.audit_neo4j.outbox -> overwatch.adapters.outbound.graph_store.queries
    overwatch.adapters.outbound.audit_neo4j.outbox -> overwatch.adapters.outbound.graph_store.scenario
    overwatch.adapters.outbound.audit_neo4j.audit_log -> overwatch.adapters.outbound.graph_store.scenario
    overwatch.adapters.outbound.graph_store.unit_of_work -> overwatch.adapters.outbound.audit_neo4j.audit_log
    overwatch.adapters.outbound.graph_store.unit_of_work -> overwatch.adapters.outbound.audit_neo4j.outbox
    overwatch.adapters.inbound.fhir_rest.app -> overwatch.adapters.inbound.sms_webhook.routes
    overwatch.adapters.inbound.fhir_rest.app -> overwatch.adapters.inbound.link_pages.capacity_links
    overwatch.adapters.inbound.sms_webhook.routes -> overwatch.adapters.outbound.sms_twilio.twilio_sms
    overwatch.adapters.inbound.scheduler.scheduled_work_consumer -> overwatch.adapters.inbound.workers.consumer
    overwatch.adapters.inbound.scheduler.scheduled_work_consumer -> overwatch.adapters.inbound.workers.tenant_binding
    overwatch.adapters.inbound.scheduler.scheduled_work_consumer -> overwatch.adapters.inbound.workers.outbox_relay
