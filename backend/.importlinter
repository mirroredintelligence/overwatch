# Architecture rules for the diucs package (hexagonal layout).
# Run from backend/: uv run lint-imports (set PYTHONIOENCODING=utf-8 on Windows, see lesson L1).
# Each contract is a rule the build enforces. Add new adapter packages to the
# "Adapters are independent" contract as they are created. Wildcards cover today's
# children; a package that is not covered by a wildcard is not checked.

[importlinter]
root_packages =
    diucs
include_external_packages = True

[importlinter:contract:layers]
name = Layers
type = layers
containers = diucs
layers =
    bootstrap
    adapters
    application
    domain

[importlinter:contract:domain-pure]
name = Domain stays pure
type = forbidden
source_modules =
    diucs.domain
forbidden_modules =
    fastapi
    neo4j
    redis
    azure
    httpx
    twilio
    pydantic_settings
    opentelemetry
    diucs.application
    diucs.adapters
    diucs.bootstrap

[importlinter:contract:application-pure]
name = Application stays pure
type = forbidden
source_modules =
    diucs.application
forbidden_modules =
    fastapi
    neo4j
    redis
    azure
    httpx
    twilio
    pydantic_settings
    opentelemetry
    diucs.adapters
    diucs.bootstrap

# TEN-001, DEC-142: the tenancy kernel is imported by the adapters and must pull nothing in with it.
[importlinter:contract:tenancy-kernel]
name = The tenancy kernel is standard library only
type = forbidden
source_modules =
    diucs.application.tenancy
forbidden_modules =
    diucs.domain
    diucs.adapters
    diucs.bootstrap
    neo4j
    redis
    azure
    fastapi
    httpx
    twilio
    pydantic
    pydantic_settings

[importlinter:contract:adapters-independent]
name = Adapters are independent
type = independence
modules =
    diucs.adapters.inbound.*
    diucs.adapters.outbound.*
    diucs.adapters.testing
# DEC-055: the audit adapter runs its queries through the G01 driver and query registry.
# DEC-084: the outbox runs its queries the same way, and the Neo4j unit of work is the one place
# that wires the audit log and the outbox into the transaction it hands out.
# TEN-004 (DEC-150): a statement carries a scenario, and the outbox builds its own from the
# scenario types of the graph store. TEN-017 gives the audit statements the same scenario types.
# I07 (DEC-149): the FHIR app mounts the Twilio webhook router, and the webhook reuses I06's
# mapping of a Twilio status, so the two statuses cannot disagree.
ignore_imports =
    diucs.adapters.outbound.audit_neo4j.audit_log -> diucs.adapters.outbound.graph_store.driver
    diucs.adapters.outbound.audit_neo4j.audit_log -> diucs.adapters.outbound.graph_store.queries
    diucs.adapters.outbound.audit_neo4j.outbox -> diucs.adapters.outbound.graph_store.driver
    diucs.adapters.outbound.audit_neo4j.outbox -> diucs.adapters.outbound.graph_store.queries
    diucs.adapters.outbound.audit_neo4j.outbox -> diucs.adapters.outbound.graph_store.scenario
    diucs.adapters.outbound.audit_neo4j.audit_log -> diucs.adapters.outbound.graph_store.scenario
    diucs.adapters.outbound.graph_store.unit_of_work -> diucs.adapters.outbound.audit_neo4j.audit_log
    diucs.adapters.outbound.graph_store.unit_of_work -> diucs.adapters.outbound.audit_neo4j.outbox
    diucs.adapters.inbound.fhir_rest.app -> diucs.adapters.inbound.sms_webhook.routes
    diucs.adapters.inbound.fhir_rest.app -> diucs.adapters.inbound.link_pages.capacity_links
    diucs.adapters.inbound.sms_webhook.routes -> diucs.adapters.outbound.sms_twilio.twilio_sms
