+    assert options[0]["travel"] == {"low_minutes": 12, "high_minutes": 24}
+    assert options[0]["position"] == {"lat": 52.0, "lon": -1.5}
+    assert (options[0]["contact_label"], options[0]["contact_phone"]) == (
+        "Duty desk",
+        "0300 123 4567",
