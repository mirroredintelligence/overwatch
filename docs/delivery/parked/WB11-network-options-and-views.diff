+
+
+async def test_a_lead_who_previews_five_wrong_codes_is_throttled(screens: AsyncClient) -> None:
+    started = await start(screens)
+    wrong = f"{(int(started['code']) + 1) % 1_000_000:06d}"
+    for _ in range(5):
