+import { describe, expect, it } from 'vitest';
+import { OWN_SCOPE, parseWallScope, scopeKey } from './scope';
+
+// Which board a wall screen shows (TEN-072, W9B's GET /screens/me/board-scope): its own organisation's or a
+// network's, with the screen's version, and a flag when the network is no longer open to it.
+
+describe('parseWallScope', () => {
+  it('reads a screen on its own board', () => {
+    expect(parseWallScope({ boardScope: 'tenant', fallback: false, scopeVersion: 2 })).toEqual({ boardScope: 'tenant', scopeVersion: 2, fallback: false, networkName: null });
+  });
+
+  it('reads a screen on a network, with the network’s name', () => {
+    expect(parseWallScope({ boardScope: 'network', fallback: false, scopeVersion: 3, networkName: 'West Dorset system' })).toEqual({
+      boardScope: 'network',
+      scopeVersion: 3,
+      fallback: false,
+      networkName: 'West Dorset system',
+    });
+  });
+
+  it('reads a screen that fell back: its own board, with the flag, and keeps no reason text', () => {
+    const scope = parseWallScope({ boardScope: 'tenant', fallback: true, fallbackReason: 'network-unavailable', scopeVersion: 4 });
+    expect(scope).toEqual({ boardScope: 'tenant', scopeVersion: 4, fallback: true, networkName: null });
+    expect(JSON.stringify(scope)).not.toContain('network-unavailable');
+  });
+
+  it('drops a field it does not know', () => {
+    const scope = parseWallScope({ boardScope: 'tenant', fallback: false, scopeVersion: 1, tenantId: 'x', networkId: 'net-x' });
+    expect(JSON.stringify(scope)).not.toMatch(/tenantId|net-x/);
+  });
+
+  it.each([
+    ['not an object', 'x'],
+    ['an unknown board', { boardScope: 'moon', fallback: false, scopeVersion: 1 }],
+    ['no flag', { boardScope: 'tenant', scopeVersion: 1 }],
+    ['a version that is not a count', { boardScope: 'tenant', fallback: false, scopeVersion: -1 }],
+    ['a network board with no name', { boardScope: 'network', fallback: false, scopeVersion: 1 }],
+    ['a network board that is also a fallback', { boardScope: 'network', fallback: true, scopeVersion: 1, networkName: 'x' }],
+    ['a name that is not text', { boardScope: 'network', fallback: false, scopeVersion: 1, networkName: 5 }],
+  ])('refuses %s', (_name, body) => {
+    expect(() => parseWallScope(body)).toThrow();
+  });
+});
+
+describe('scopeKey', () => {
+  it('is the same for the same board and version', () => {
+    expect(scopeKey(OWN_SCOPE)).toBe(scopeKey({ ...OWN_SCOPE }));
+  });
+
+  it('changes with the board, the version and the fallback flag, so a held figure is never read as another scope’s', () => {
+    const base = { boardScope: 'network' as const, scopeVersion: 1, fallback: false, networkName: 'A' };
+    const keys = new Set([
+      scopeKey(base),
+      scopeKey({ ...base, scopeVersion: 2 }),
+      scopeKey({ ...base, boardScope: 'tenant', networkName: null }),
+      scopeKey({ ...base, boardScope: 'tenant', networkName: null, fallback: true }),
+      scopeKey({ ...base, networkName: 'B' }),
+    ]);
+    expect(keys.size).toBe(5);
+  });
+});
diff --git a/frontend/lib/board/scope.ts b/frontend/lib/board/scope.ts
new file mode 100644
index 0000000..344faf9
--- /dev/null
+++ b/frontend/lib/board/scope.ts
@@ -0,0 +1,47 @@
+// Which board a wall screen shows (TEN-072, docs/design/network-ui.md section 6): its own organisation's
+// or a network's, read from the back end's `GET /screens/me/board-scope` (W9B). The screen's version
+// changes whenever its administrator changes the board, and `fallback` says it is set to a network that is
+// no longer open to it, so it shows its own board with a notice. The name of the network is the only thing
+// of a network that reaches the screen. Nothing here is an identifier of a tenant or a network.
+
+export type WallScope = {
+  boardScope: 'tenant' | 'network';
+  scopeVersion: number;
+  /** The screen is set to a network that is no longer open to it: it shows its own board and says so. */
+  fallback: boolean;
+  /** The network's name, only when the screen shows a network now. */
+  networkName: string | null;
+};
+
+/** What a screen that has not been told otherwise shows: its own organisation's board. */
+export const OWN_SCOPE: WallScope = { boardScope: 'tenant', scopeVersion: 0, fallback: false, networkName: null };
+
+const NAME_MAX = 200;
+
+export class WallScopeError extends Error {
+  constructor() {
+    super('The screen’s board setting is not in the expected shape.');
+    this.name = 'WallScopeError';
+  }
+}
+
+/** Reads the back end's answer, and the BFF's, which has the same fields. Fails closed; keeps only what it knows. */
+export function parseWallScope(value: unknown): WallScope {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) throw new WallScopeError();
+  const { boardScope, fallback, scopeVersion, networkName } = value as Record<string, unknown>;
+  if (boardScope !== 'tenant' && boardScope !== 'network') throw new WallScopeError();
+  if (typeof fallback !== 'boolean') throw new WallScopeError();
+  if (typeof scopeVersion !== 'number' || !Number.isInteger(scopeVersion) || scopeVersion < 0) throw new WallScopeError();
+  if (networkName !== undefined && networkName !== null && (typeof networkName !== 'string' || networkName.length > NAME_MAX)) throw new WallScopeError();
+  if (boardScope === 'network' && (typeof networkName !== 'string' || networkName === '' || fallback)) throw new WallScopeError();
+  return { boardScope, scopeVersion, fallback, networkName: boardScope === 'network' ? (networkName as string) : null };
+}
+
+/**
+ * What the figures held belong to. A figure is only ever shown as last known under the key it was read
+ * under: when the key changes (the administrator chose another board, the version moved, or the screen
+ * fell back) the figures of the old key are dropped, never carried over.
+ */
+export function scopeKey(scope: WallScope): string {
+  return JSON.stringify([scope.boardScope, scope.scopeVersion, scope.fallback, scope.networkName]);
+}
