+++ b/backend/tests/unit/support/test_start_container.py
@@ -534,6 +534,7 @@ def test_a_lock_that_stays_taken_fails_in_the_lock_phase_naming_the_holder(
     other = os.open(path, os.O_RDWR)
     fcntl.flock(other, fcntl.LOCK_EX)  # another process holds it, as far as this one can tell
     monkeypatch.setenv("DIUCS_NEO4J_LOCK_TIMEOUT", "0.3")
+    monkeypatch.setenv("DIUCS_NEO4J_SLOTS", "1")  # with spare slots a second run would not wait
     clock = FakeClock()
     docker = FakeDocker(clock)
     try:
