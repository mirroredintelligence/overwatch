    "t5": { "x": 0, "y": 5900, "text": "Clinical advisor: on duty, queue, case, advice", "kind": "title1", "maxW": 5360 },
    "t6": { "x": 0, "y": 7200, "text": "Wall screen: readable from three metres", "kind": "title1", "maxW": 4960 },
    "n0": { "x": 1360, "y": 840, "w": 360, "fill": "blue", "text": "This is the morph prototype from the first canvas, reused unchanged. Every board here is a step, a sub-view or an exception of it, in the same shell." },
    "n1": { "x": 0, "y": 2140, "w": 340, "fill": "gray", "text": "A shape and a word say each status, never colour alone: filled circle Accepting, half Limited, square Not accepting, triangle Over capacity, dashed ring Not updated." },
    "n2": { "x": 0, "y": 3340, "w": 340, "fill": "teal", "text": "Compare does not score or rank. Rows that need data we do not hold say Not available, never zero." },
    "n3": { "x": 4080, "y": 3340, "w": 340, "fill": "teal", "text": "Drive-time rings and traffic have no data yet, so the radar shows them as off and says so." },
    "n4": { "x": 8160, "y": 3340, "w": 340, "fill": "orange", "text": "Never end a call on a refusal: this empty state always offers a next step, and Ask a clinical advisor is one." },
    "n5": { "x": 0, "y": 8460, "w": 340, "fill": "gray", "text": "The wall board shows capacity only. No patient information appears here, ever." }
  },
