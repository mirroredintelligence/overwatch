    "t0": { "x": 0, "y": -300, "text": "Start here: the index, and the call itself", "kind": "title1", "maxW": 2640 },
    "t1": { "x": 0, "y": 1000, "text": "The live board: five honest states", "kind": "title1", "maxW": 6720 },
